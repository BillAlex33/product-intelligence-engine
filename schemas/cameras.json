{
  "category": "cameras",
  "version": 1,
  "attributes": [
    {"name":"body_weight_g","type":"number","unit":"g","comparable":true},
    {"name":"sensor_width_mm","type":"number","unit":"mm","comparable":true},
    {"name":"sensor_height_mm","type":"number","unit":"mm","comparable":true},
    {"name":"megapixels","type":"number","unit":"MP","comparable":true},
    {"name":"ibis_stops","type":"number","unit":"stops","comparable":true},
    {"name":"max_video_fps","type":"number","unit":"fps","comparable":true},
    {"name":"weather_sealed","type":"boolean","comparable":true}
  ],
  "derived_metrics": [
    {"name":"megapixels_per_100g","formula":"megapixels/(body_weight_g/100)"},
    {"name":"sensor_area_per_gram","formula":"(sensor_width_mm*sensor_height_mm)/body_weight_g"}
  ]
}